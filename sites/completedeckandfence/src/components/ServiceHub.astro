---
import Base from "../layouts/Base.astro";
import { Picture, getImage } from "astro:assets";
import Breadcrumbs from "./Breadcrumbs.astro";
import Sections from "./Sections.astro";
import Faqs from "./Faqs.astro";
import Toc from "./Toc.astro";
import Steps from "./Steps.astro";
import EstimateSection from "./EstimateSection.astro";
import WorkGallery from "./WorkGallery.astro";
import { work } from "../lib/work.js";
import { paths, guides, getPageContent, getCityContent, getGuideContent, citiesByCounty, inlineHtml, breadcrumbSchema, faqSchema, serviceSchema } from "../lib/site.js";

const { service, photo, photoAlt, concept = false, gallery = [] } = Astro.props;
const isDeck = service === "deck";
const page = getPageContent(isDeck ? "decks" : "fences");
if (!page) throw new Error(`Missing src/content/pages/${isDeck ? "decks" : "fences"}.json`);
const path = isDeck ? paths.decks : paths.fences;
const heroPreload = await getImage({ src: photo, format: "avif", quality: 45, widths: [480, 800, 1100] });
const h1 = isDeck ? "Deck builders in Middle Tennessee" : "Fence installation in Middle Tennessee";
const title = isDeck ? "Deck Builders in Middle Tennessee" : "Fence Company in Middle Tennessee";
const crumbs = [{ name: "Home", href: "/" }, { name: isDeck ? "Decks" : "Fences", href: path }];
const groups = citiesByCounty().map((g) => ({ ...g, cities: g.cities.filter((c) => getCityContent(c.slug)) })).filter((g) => g.cities.length);
const cityPath = (slug) => (isDeck ? paths.deckCity(slug) : paths.fenceCity(slug));
const related = guides.filter((g) => getGuideContent(g.slug) && (g.service === service || g.service === "both"));
const schema = [
  breadcrumbSchema(crumbs),
  faqSchema(page.faqs),
  serviceSchema({ name: h1, serviceType: isDeck ? "Deck building" : "Fence installation", url: path, description: page.description }),
];
---
<Base title={title} description={page.description} path={path} schema={schema} current={path} image={photo}>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroPreload.srcSet.attribute} imagesizes="(max-width: 900px) 100vw, 45vw" fetchpriority="high" />
  <section class="page-hero">
    <div class="wrap page-hero-inner">
      <div class="page-hero-copy">
        <Breadcrumbs items={crumbs} />
        <p class="kicker">Middle Tennessee</p>
        <h1 class="page-title">{h1}</h1>
        <p class="page-lede" set:html={inlineHtml(page.intro)} />
        <div class="hero-actions">
          <a class="btn btn-red" href="#estimate" data-project={service}>{isDeck ? "Plan your deck" : "Plan your fence"} <span class="arrow" aria-hidden="true"></span></a>
          <a class="btn btn-ghost" href="#cities">Find your city</a>
        </div>
      </div>
      <figure class="page-hero-media">
        <Picture src={photo} formats={["avif", "webp"]} quality={45} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 45vw" alt={photoAlt} loading="eager" fetchpriority="high" />
        {concept && <figcaption class="tag">Concept image</figcaption>}
      </figure>
    </div>
  </section>

  {gallery.length > 0 && <WorkGallery items={gallery} heading={isDeck ? "Decks we've built." : "Fences we've built."} />}

  <div class="wrap article-layout">
    <article class="article-body">
      <Sections sections={page.sections} />
      <Faqs faqs={page.faqs} heading={isDeck ? "Deck questions we hear a lot" : "Fence questions we hear a lot"} id="questions" />
    </article>
    <Toc sections={page.sections} faqsId="questions" cta={isDeck ? "Plan your deck" : "Plan your fence"} />
  </div>

  <section class="city-index" id="cities" aria-labelledby="cities-title">
    <div class="wrap">
      <h2 id="cities-title" class="h2">{isDeck ? "Deck builder by city." : "Fence company by city."}</h2>
      <div class="county-grid">
        {groups.map((g) => (
          <div class="county">
            <p class="county-name">{g.county}</p>
            <ul>{g.cities.map((c) => <li><a href={cityPath(c.slug)}>{isDeck ? "Decks" : "Fences"} in {c.name}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="related" aria-labelledby="guides-title">
    <div class="wrap">
      <h2 id="guides-title" class="related-title">{isDeck ? "Deck guides" : "Fence guides"}</h2>
      <ul class="related-list related-list-wide">
        {related.map((g) => <li><a href={paths.guide(g.slug)}>{g.title}</a></li>)}
      </ul>
    </div>
  </section>

  <Steps />
  <EstimateSection project={isDeck ? "Deck" : "Fence"} heading={isDeck ? "Let's plan your deck." : "Let's plan your fence."} />
</Base>
