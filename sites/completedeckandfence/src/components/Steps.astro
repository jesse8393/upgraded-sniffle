---
const { heading = "What happens after you reach out." } = Astro.props;
---
<section class="approach" id="approach" aria-labelledby="approach-title">
  <div class="wrap approach-inner">
    <h2 id="approach-title" class="h2">{heading}</h2>
    <ol class="steps">
      <li><h3>You tell us what you have in mind</h3><p>Use the form below. A rough idea is plenty to start.</p></li>
      <li><h3>We come look at the yard</h3><p>We see the space in person and talk through options with you.</p></li>
      <li><h3>You get an estimate</h3><p>You see the materials and the price before any work starts.</p></li>
      <li><h3>We build it</h3><p>Once you say go, we schedule the job and get to work.</p></li>
    </ol>
  </div>
</section>
