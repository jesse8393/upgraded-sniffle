---
import Base from "../layouts/Base.astro";
import { paths } from "../lib/site.js";
---
<Base title="Page Not Found" description="That page is not here. Find decks, fences, the cities we serve, and our guides from the links below." path="/404/" noindex estimateHref="/#estimate">
  <section class="page-hero page-hero-plain not-found">
    <div class="wrap">
      <p class="kicker">Not found</p>
      <h1 class="page-title">That page is not here.</h1>
      <p class="page-lede">It may have moved. These will get you where you were headed.</p>
      <ul class="related-list related-list-wide">
        <li><a href="/">Home</a></li>
        <li><a href={paths.decks}>Decks</a></li>
        <li><a href={paths.fences}>Fences</a></li>
        <li><a href={paths.areas}>Service areas</a></li>
        <li><a href={paths.guides}>Guides</a></li>
      </ul>
    </div>
  </section>
</Base>
