---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, paths, breadcrumbSchema } from "../lib/site.js";
const crumbs = [{ name: "Home", href: "/" }, { name: "Privacy policy", href: paths.privacy }];
---
<Base title="Privacy Policy" description="How Complete Deck & Fence handles the information you send through the estimate form on this website." path={paths.privacy} schema={[breadcrumbSchema(crumbs)]} estimateHref="/#estimate">
  <section class="page-hero page-hero-plain">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1 class="page-title">Privacy policy</h1>
    </div>
  </section>
  <div class="wrap article-body article-narrow legal">
    <h2>What we collect</h2>
    <p>When you send an estimate request, we receive what you type into the form: your name, phone number, email address, ZIP code, the kind of project, when you would like to start, any notes, and the page you sent it from.</p>
    <h2>How we use it</h2>
    <p>We use it to answer your request, set up a visit, and talk through your project. We do not sell it, and we do not share it with anyone else except the service that delivers the form to us.</p>
    <h2>Cookies and tracking</h2>
    <p>This site does not set its own cookies or run advertising trackers. If that changes, this page will say so before it does.</p>
    <h2>Your choices</h2>
    <p>You can ask us to update or delete the information you sent at any time.{SITE.email ? <> Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</> : " Send the request through the estimate form and tell us what you want changed."}</p>
    <h2>Changes to this policy</h2>
    <p>If this policy changes, the new version will be posted on this page.</p>
  </div>
</Base>
