---
import Base from "../layouts/Base.astro";
import { Picture, getImage } from "astro:assets";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Sections from "../components/Sections.astro";
import Faqs from "../components/Faqs.astro";
import Toc from "../components/Toc.astro";
import Steps from "../components/Steps.astro";
import EstimateSection from "../components/EstimateSection.astro";
import WorkGallery from "../components/WorkGallery.astro";
import { work } from "../lib/work.js";
import { paths, getPageContent, inlineHtml, breadcrumbSchema, faqSchema, serviceSchema } from "../lib/site.js";

const page = getPageContent("porches");
const crumbs = [{ name: "Home", href: "/" }, { name: "Porches", href: paths.porches }];
const hero = work.coveredDeck;
const heroPreload = await getImage({ src: hero.src, format: "avif", quality: 45, widths: [480, 800, 1100] });
const schema = [
  breadcrumbSchema(crumbs),
  faqSchema(page.faqs),
  serviceSchema({ name: "Covered porches, screened porches, and gazebos in Middle Tennessee", serviceType: "Porch and gazebo construction", url: paths.porches, description: page.description }),
];
---
<Base title="Covered and Screened Porches in Middle TN" description={page.description} path={paths.porches} schema={schema} current={paths.porches} image={hero.src}>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroPreload.srcSet.attribute} imagesizes="(max-width: 900px) 100vw, 45vw" fetchpriority="high" />
  <section class="page-hero">
    <div class="wrap page-hero-inner">
      <div class="page-hero-copy">
        <Breadcrumbs items={crumbs} />
        <p class="kicker">Middle Tennessee</p>
        <h1 class="page-title">Covered porches, screened porches, and gazebos</h1>
        <p class="page-lede" set:html={inlineHtml(page.intro)} />
        <div class="hero-actions">
          <a class="btn btn-red" href="#estimate">Plan your porch <span class="arrow" aria-hidden="true"></span></a>
          <a class="btn btn-ghost" href={paths.decks}>Decks</a>
        </div>
      </div>
      <figure class="page-hero-media">
        <Picture src={hero.src} formats={["avif", "webp"]} quality={45} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 45vw" alt={hero.alt} loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <WorkGallery items={[work.gazeboPool, work.coveredInside, work.whiteDeckPorch, work.whiteDeckSide]} heading="Porches we've built." />

  <div class="wrap article-layout">
    <article class="article-body">
      <Sections sections={page.sections} />
      <Faqs faqs={page.faqs} heading="Porch questions we hear a lot" id="questions" />
    </article>
    <Toc sections={page.sections} faqsId="questions" cta="Plan your porch" />
  </div>

  <Steps />
  <EstimateSection project="Porch or gazebo" heading="Let's plan your porch." />
</Base>
