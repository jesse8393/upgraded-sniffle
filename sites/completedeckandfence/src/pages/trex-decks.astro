---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Sections from "../components/Sections.astro";
import Faqs from "../components/Faqs.astro";
import Toc from "../components/Toc.astro";
import Steps from "../components/Steps.astro";
import EstimateSection from "../components/EstimateSection.astro";
import { paths, guides, getPageContent, getCityContent, getGuideContent, citiesByCounty, inlineHtml, breadcrumbSchema, faqSchema, serviceSchema } from "../lib/site.js";

const page = getPageContent("trex-decks");
if (!page) throw new Error("Missing src/content/pages/trex-decks.json");
const h1 = "Trex deck installation in Middle Tennessee";
const crumbs = [{ name: "Home", href: "/" }, { name: "Decks", href: paths.decks }, { name: "Trex decks", href: paths.trex }];
const groups = citiesByCounty().map((g) => ({ ...g, cities: g.cities.filter((c) => getCityContent(c.slug)) })).filter((g) => g.cities.length);
const related = ["wood-vs-composite-decking", "deck-cost-middle-tennessee", "signs-you-need-a-new-deck", "deck-maintenance-tennessee", "hoa-approval-deck-fence"]
  .map((slug) => guides.find((g) => g.slug === slug)).filter((g) => g && getGuideContent(g.slug));
const schema = [
  breadcrumbSchema(crumbs),
  faqSchema(page.faqs),
  serviceSchema({ name: h1, serviceType: "Composite deck installation", url: paths.trex, description: page.description }),
];
---
<Base title="Trex Deck Installation in Middle TN" description={page.description} path={paths.trex} schema={schema} current={paths.decks}>
  <section class="page-hero page-hero-plain">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="kicker">Composite decking</p>
      <h1 class="page-title">{h1}</h1>
      <p class="page-lede" set:html={inlineHtml(page.intro)} />
      <div class="hero-actions">
        <a class="btn btn-red" href="#estimate" data-project="Deck">Plan your Trex deck <span class="arrow" aria-hidden="true"></span></a>
        <a class="btn btn-ghost" href="#cities">Find your city</a>
      </div>
    </div>
  </section>

  <div class="wrap article-layout">
    <article class="article-body">
      <Sections sections={page.sections} />
      <Faqs faqs={page.faqs} heading="Trex deck questions we hear a lot" id="questions" />
      <p class="fine-print">Trex is a registered trademark of Trex Company, Inc.</p>
    </article>
    <Toc sections={page.sections} faqsId="questions" cta="Plan your deck" />
  </div>

  <section class="city-index" id="cities" aria-labelledby="cities-title">
    <div class="wrap">
      <h2 id="cities-title" class="h2">Trex decks by city.</h2>
      <div class="county-grid">
        {groups.map((g) => (
          <div class="county">
            <p class="county-name">{g.county}</p>
            <ul>{g.cities.map((c) => <li><a href={paths.deckCity(c.slug)}>Decks in {c.name}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="related" aria-labelledby="guides-title">
    <div class="wrap">
      <h2 id="guides-title" class="related-title">Deck guides</h2>
      <ul class="related-list related-list-wide">
        {related.map((g) => <li><a href={paths.guide(g.slug)}>{g.title}</a></li>)}
      </ul>
    </div>
  </section>

  <Steps />
  <EstimateSection project="Deck" heading="Let's plan your Trex deck." />
</Base>
