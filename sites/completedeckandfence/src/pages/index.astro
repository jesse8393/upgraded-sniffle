---
import Base from "../layouts/Base.astro";
import { Picture, getImage } from "astro:assets";
import Steps from "../components/Steps.astro";
import Sections from "../components/Sections.astro";
import Faqs from "../components/Faqs.astro";
import EstimateSection from "../components/EstimateSection.astro";
import deckHero from "../assets/photos/deck-hero.jpg";
import fencePhoto from "../assets/photos/fence-privacy.jpg";
import yardSign from "../assets/photos/yard-sign.jpg";
import { paths, guides, getPageContent, getGuideContent, getCityContent, faqSchema, citiesByCounty } from "../lib/site.js";

const home = getPageContent("home");
// Start the hero photo download before the browser reaches the <img>.
const heroPreload = await getImage({ src: deckHero, format: "avif", quality: 55, widths: [480, 800, 1100, 1400] });
const groups = citiesByCounty().map((g) => ({ ...g, cities: g.cities.filter((c) => getCityContent(c.slug)) })).filter((g) => g.cities.length);
const featuredGuides = ["wood-vs-composite-decking", "privacy-fence-options", "deck-cost-middle-tennessee", "fence-on-a-slope"]
  .map((slug) => guides.find((g) => g.slug === slug)).filter((g) => g && getGuideContent(g.slug));
---
<Base
  title=""
  description="Custom decks and fences for Middle Tennessee homes, from Murfreesboro and Nashville to Franklin and Cookeville. Plan your project and request an estimate."
  path="/"
  schema={[faqSchema(home?.faqs)]}
>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroPreload.srcSet.attribute} imagesizes="(max-width: 900px) 100vw, 55vw" fetchpriority="high" />
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="kicker rise">Middle Tennessee</p>
      <h1 id="hero-title" class="display rise" style="--d:60ms">Make outside<br> feel <span class="nowrap">complete.</span></h1>
      <p class="lede rise" style="--d:120ms">Custom decks. Beautiful fences. Better weekends.</p>
      <div class="hero-actions rise" style="--d:180ms">
        <a class="btn btn-red" href="#estimate">Plan your project <span class="arrow" aria-hidden="true"></span></a>
        <a class="btn btn-ghost" href="#services">See what we build</a>
      </div>
    </div>
    <figure class="hero-media">
      <Picture src={deckHero} formats={["avif", "webp"]} quality={55} widths={[480, 800, 1100, 1400]} sizes="(max-width: 900px) 100vw, 55vw" alt="Stained wood deck with black railings and wide steps behind a white two story home" loading="eager" fetchpriority="high" />
      <span class="c-bracket" aria-hidden="true"></span>
      <figcaption class="tag">Concept image</figcaption>
    </figure>
  </section>

  <section class="services" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <h2 id="services-title" class="h2 services-title">Built around your life.</h2>
      <div class="service-cols">
        <article class="service" aria-labelledby="decks-title">
          <h3 id="decks-title" class="service-title"><a href={paths.decks}>Custom decks</a></h3>
          <p>Tell us how you use the yard. We'll lay out a deck that fits your house and your slope.</p>
          <ul class="ticks">
            <li>New decks and replacements</li>
            <li>Stairs and railings</li>
            <li>Wood or composite boards</li>
          </ul>
          <a class="text-link" href={paths.decks}>See our deck work <span class="arrow" aria-hidden="true"></span></a>
        </article>
        <article class="service" aria-labelledby="fences-title">
          <h3 id="fences-title" class="service-title"><a href={paths.fences}>Privacy fences</a></h3>
          <p>Keep the dog in and the street out. Tell us where the line runs and how tall you want it.</p>
          <ul class="ticks">
            <li>Privacy and picket styles</li>
            <li>Walk gates and drive gates</li>
          </ul>
          <a class="text-link" href={paths.fences}>See our fence work <span class="arrow" aria-hidden="true"></span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="band-title">
    <div class="band-top">
      <div class="wrap band-inner">
        <h2 id="band-title" class="band-title">A little privacy.<br>A lot more peace.</h2>
        <a class="btn btn-light" href="#estimate" data-project="fence">Request an estimate <span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
    <div class="band-media">
      <figure class="wrap">
        <Picture src={fencePhoto} formats={["avif", "webp"]} quality={62} widths={[480, 720, 960, 1240]} sizes="(max-width: 1240px) 100vw, 1240px" alt="Cedar privacy fence with a matching gate and black hardware" />
        <figcaption class="tag">Concept image</figcaption>
      </figure>
    </div>
  </section>

  <Steps />

  {home && (
    <section class="home-more" aria-label="More about our work">
      <div class="wrap article-body">
        <Sections sections={home.sections} />
      </div>
    </section>
  )}

  <section class="area" id="area" aria-labelledby="area-title">
    <div class="wrap area-inner">
      <figure class="area-media">
        <Picture src={yardSign} formats={["avif", "webp"]} quality={62} widths={[480, 720, 960, 1280]} sizes="(max-width: 860px) 100vw, 50vw" alt="Complete Deck and Fence yard sign reading Built for better backyards, in front of a finished deck" />
      </figure>
      <div class="area-copy">
        <h2 id="area-title" class="h2">Seen our sign in your neighborhood?</h2>
        <p>We build decks and fences for homeowners across Middle Tennessee. Not sure we cover your street? Put your ZIP code in the form and we'll let you know.</p>
        <a class="btn btn-dark" href={paths.areas}>See every city we serve <span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <section class="city-index" aria-labelledby="cities-title">
    <div class="wrap">
      <h2 id="cities-title" class="h2">Where we build.</h2>
      <div class="county-grid">
        {groups.map((g) => (
          <div class="county">
            <p class="county-name">{g.county}</p>
            <ul>
              {g.cities.map((c) => <li><a href={paths.cityHub(c.slug)}>{c.name}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="guide-teaser" aria-labelledby="guides-title">
    <div class="wrap">
      <div class="teaser-head">
        <h2 id="guides-title" class="h2">Plan it before you call.</h2>
        <a class="text-link" href={paths.guides}>All guides <span class="arrow" aria-hidden="true"></span></a>
      </div>
      <ul class="guide-list">
        {featuredGuides.map((g) => (
          <li><a href={paths.guide(g.slug)}><span class="guide-kind">{g.service === "deck" ? "Decks" : g.service === "fence" ? "Fences" : "Decks and fences"}</span>{g.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

  {home?.faqs && (
    <div class="wrap faq-wrap">
      <Faqs faqs={home.faqs} heading="Questions we hear a lot" />
    </div>
  )}

  <EstimateSection />
</Base>
